# Apache 2.4. Веб-корень = dist/. backend/, storage/ и .env лежат вне веб-корня.
Options -Indexes
DirectoryIndex index.html index.php
AddDefaultCharset utf-8
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # /page/index.html → /page/ (один канонический адрес).
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^(.*)index\.html$ /$1 [R=301,L,NE]
  # Адрес без завершающего слеша, если есть такая папка.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  <FilesMatch "\.(css|js|woff2|avif|webp|png|jpe?g|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/avif .avif
  AddType image/webp .webp
</IfModule>

# Служебные файлы не отдаём.
<FilesMatch "^(\.(?!well-known)|.*\.(env|log|jsonl|sql|sqlite|bak|zip|tar|gz|md|lock)$|composer\.(json|lock)$|package(-lock)?\.json$)">
  Require all denied
</FilesMatch>
