---
layout: layouts/base.njk
---
{#- Документ из src/content/pages/privacy.md. -#}
{%- set doc = collections.pages | findBySlug("privacy") %}
<article>
  <section class="page-head">
    <div class="container">
      <h1>{{ doc.data.title }}</h1>
      {%- if doc.data.lead %}
      <p class="lead">{{ doc.data.lead }}</p>
      {%- endif %}
    </div>
  </section>
  <div class="section section--tight">
    <div class="container">
      <div class="prose doc-body doc-body--legal plane">
        {{ doc.content | safe }}
      </div>
    </div>
  </div>
</article>
