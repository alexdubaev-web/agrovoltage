---
layout: layouts/base.njk
title: Контакты
permalink: /kontakty/
breadcrumbs:
  - name: Главная
    url: /
  - name: Контакты
---
{#- Контакты: телефон, почта, MAX, адрес, часы, края (из settings), карта по клику, форма. -#}
{%- from "partials/icon.njk" import icon -%}
<section class="page-head">
  <div class="container">
    <h1>Контакты</h1>
    <p class="lead">Позвоните мастеру или оставьте заявку. Работаем {{ regionText }}.</p>
  </div>
</section>

<section class="section section--tight" aria-label="Как связаться">
  <div class="container contact-grid">
    <section class="plane contact-card contact-card--main" aria-labelledby="svyaz-title">
      <h2 id="svyaz-title">Связаться</h2>
      <a class="contact-card__phone" href="{{ settings.phoneHref }}" data-goal="phone">{{ icon("phone") }}{{ settings.phone }}</a>
      <dl class="contact-list">
        <div><dt>Почта</dt><dd>{% if settings.email | isPlaceholder %}{% set value = settings.email %}{% include "partials/contact-value.njk" %}{% else %}<a href="mailto:{{ settings.email }}">{{ settings.email }}</a>{% endif %}</dd></div>
        <div><dt>MAX</dt><dd>{% if settings.maxUrl | isPlaceholder %}{% set value = settings.maxUrl %}{% include "partials/contact-value.njk" %}{% else %}<a href="{{ settings.maxUrl }}" rel="noopener">Написать в MAX</a>{% endif %}</dd></div>
      </dl>
      <p class="actions"><a class="btn btn--primary" href="#zayavka" data-lead-open>Оставить заявку</a></p>
    </section>
    <section class="plane contact-card" aria-labelledby="adres-title">
      <h2 id="adres-title">Адрес и часы работы</h2>
      <dl class="contact-list">
        <div><dt>Адрес</dt><dd>{% set value = settings.address %}{% include "partials/contact-value.njk" %}</dd></div>
        <div><dt>Часы работы</dt><dd>{% set value = settings.hours %}{% include "partials/contact-value.njk" %}</dd></div>
      </dl>
    </section>
    <section class="plane contact-card" aria-labelledby="regiony-title">
      <h2 id="regiony-title">Где работаем</h2>
      <ul class="contact-regions" role="list">
        {%- for name in settings.regions %}
        <li>{% set found = false %}{% for region in collections.regions %}{% if region.data.title == name %}{% set found = region.url %}{% endif %}{% endfor %}{% if found %}<a href="{{ found }}">{{ name }}</a>{% else %}{{ name }}{% endif %}</li>
        {%- endfor %}
      </ul>
    </section>
  </div>
</section>

<section class="section section--tight" id="karta" aria-labelledby="karta-title">
  <div class="container">
    <h2 id="karta-title">Карта</h2>
    {%- set mapQuery = settings.regions | join(", ") if (settings.address | isPlaceholder) else settings.address %}
    {%- if settings.address | isPlaceholder %}
    <p class="muted">Точный адрес появится после того, как его внесут в настройки. Пока карта показывает края, где работаем.</p>
    {%- endif %}
    <div id="map-box" data-map-src="https://yandex.ru/map-widget/v1/?text={{ mapQuery | urlencode }}">
      <button class="btn btn--ghost" type="button" id="map-load">Показать карту</button>
    </div>
    <script>
      (function () {
        var button = document.getElementById("map-load");
        var box = document.getElementById("map-box");
        if (!button || !box) return;
        button.addEventListener("click", function () {
          var frame = document.createElement("iframe");
          frame.src = box.getAttribute("data-map-src");
          frame.title = "Карта";
          frame.width = "100%";
          frame.height = "400";
          frame.loading = "lazy";
          frame.style.border = "0";
          box.replaceChildren(frame);
        });
      })();
    </script>
  </div>
</section>

<section class="contact-band" id="forma" aria-labelledby="forma-title">
  <div class="container contact-band__inner">
    <div class="contact-band__head">
      <h2 id="forma-title">Написать нам</h2>
      <a class="contact-band__phone" href="{{ settings.phoneHref }}" data-goal="phone">{{ icon("phone") }}{{ settings.phone }}</a>
    </div>
    {% set leadForm = { type: "callback", id: "page", variant: "inline", messageLabel: "Что с машиной" } %}
    {% include "partials/lead-form.njk" %}
  </div>
</section>
