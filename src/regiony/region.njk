---
layout: layouts/base.njk
pagination:
  data: collections.regions
  size: 1
  alias: region
---
{#- Страница края: край в H1 и title (история 11), населённые пункты, услуги строками, FAQ, форма. -#}
{%- from "partials/icon.njk" import icon -%}
{%- set r = region.data -%}
<article>
  <section class="page-head">
    <div class="container">
      <h1>Ремонт электрики John Deere: {{ r.title }}</h1>
      <p class="lead">{{ r.lead }}</p>
      <div class="actions">
        <a class="btn btn--primary" href="#zayavka" data-lead-open data-message="Регион: {{ r.title }}">Оставить заявку</a>
        <a class="btn btn--ghost" href="{{ settings.phoneHref }}" data-goal="phone">{{ icon("phone") }}Позвонить</a>
      </div>
    </div>
  </section>
  {%- if region.content %}
  <div class="section section--tight">
    <div class="container prose">{{ region.content | safe }}</div>
  </div>
  {%- endif %}
  {%- if r.localities and r.localities.length %}
  <section class="section section--tight" aria-labelledby="places-title">
    <div class="container">
      <h2 id="places-title">Населённые пункты</h2>
      <ul class="chip-list" role="list">{% for place in r.localities %}<li class="chip chip--static">{{ place }}</li>{% endfor %}</ul>
    </div>
  </section>
  {%- endif %}
  <section class="section" id="uslugi" aria-labelledby="uslugi-title">
    <div class="container">
      <h2 id="uslugi-title">Услуги в крае</h2>
      <ul class="service-group__rows service-rows" role="list">
        {%- asyncEach item in collections.services %}
        <li class="service-row">
          <span class="service-row__media">{% if item.data.image %}{% image item.data.image, item.data.title, "(min-width: 769px) 136px, 112px" %}{% endif %}</span>
          <span class="service-row__text">
            <a class="service-row__link" href="{{ item.url }}">{{ item.data.title }}</a>
            <span class="service-row__summary">{{ item.data.summary }}{% if item.data.demo %} <span class="badge badge--demo">Демо</span>{% endif %}</span>
          </span>
          <span class="service-row__price">{% if item.data.priceFrom %}от {{ item.data.priceFrom | price }}{% else %}по запросу{% endif %}</span>
          <span class="btn-round" aria-hidden="true">{{ icon("arrow") }}</span>
        </li>
        {%- endeach %}
      </ul>
    </div>
  </section>
  {%- if r.faq and r.faq.length %}
  <section class="section section--alt" id="faq" aria-labelledby="faq-title">
    <div class="container aside-layout">
      <h2 id="faq-title">Частые вопросы</h2>
      <div class="faq">
        {%- for item in r.faq %}
        <details>
          <summary>{{ item.q }}{{ icon("chevron", "faq__chevron") }}</summary>
          <div class="faq__answer"><p>{{ item.a }}</p></div>
        </details>
        {%- endfor %}
      </div>
    </div>
  </section>
  {%- endif %}
  <section class="contact-band" id="forma" aria-labelledby="forma-title">
    <div class="container contact-band__inner">
      <div class="contact-band__head">
        <h2 id="forma-title">Заявка: {{ r.title }}</h2>
        <a class="contact-band__phone" href="{{ settings.phoneHref }}" data-goal="phone">{{ icon("phone") }}{{ settings.phone }}</a>
      </div>
      {% set leadForm = { type: "callback", id: "region", variant: "inline", message: "Регион: " + r.title, messageLabel: "Район и что с машиной" } %}
      {% include "partials/lead-form.njk" %}
    </div>
  </section>
</article>
