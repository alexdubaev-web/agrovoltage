---
pagination:
  data: collections.products
  size: 1
  alias: product
permalink: "{{ product.url }}"
---
{#- Карточка товара. Контракт корзины: data-add-to-cart, data-add-qty, data-add-status. -#}
{%- from "partials/icon.njk" import icon -%}
{%- set pImg = product.data.images | first -%}
<article class="product" data-product>
  <section class="page-head">
    <div class="container product__grid">
      <div class="product__media">
        {%- if pImg %}{% image pImg, product.data.title, "(min-width: 1024px) 560px, 100vw", true %}{% else %}<span class="product-ph product-ph--large" role="img" aria-label="Фото скоро появится"></span>{% endif %}
      </div>
      <div class="product__info">
        <h1>{{ product.data.title }}</h1>
        <p class="product__sku">Артикул: {{ product.data.sku }}{% if product.data.demo %} <span class="badge badge--demo">Демо</span>{% endif %}</p>
        <div class="product__buy plane">
          <p class="product__price">{{ product.data.price | price }}</p>
          <p class="product__stock">{% if product.data.inStock %}<span class="badge badge--live">{{ icon("check") }}В наличии</span>{% else %}<span class="badge badge--demo">Под заказ</span>{% endif %}</p>
          {%- if product.data.price is not number %}<p class="product__hint">Цену назовёт менеджер, когда сверит деталь под вашу машину.</p>{% endif %}
          <div class="product__actions">
            <label class="visually-hidden" for="qty-{{ product.slug }}">Количество</label>
            <input class="field__input product__qty" id="qty-{{ product.slug }}" type="number" min="1" max="999" value="1" inputmode="numeric" data-add-qty>
            <button class="btn btn--primary" type="button" data-add-to-cart data-slug="{{ product.slug }}" data-title="{{ product.data.title }}" data-price="{% if product.data.price is number %}{{ product.data.price }}{% endif %}">{{ icon("cart") }}В корзину</button>
          </div>
          <p class="product__status" data-add-status role="status" aria-live="polite"></p>
          <a class="product__to-cart" href="/korzina/">Перейти в корзину</a>
        </div>
        {%- if product.data.summary %}<p class="product__summary">{{ product.data.summary }}</p>{% endif %}
      </div>
    </div>
  </section>

  {%- set hasCompat = product.data.compatibility and product.data.compatibility.length %}
  {%- set hasSpecs = product.data.specs and product.data.specs.length %}
  {%- if hasCompat or hasSpecs %}
  <div class="section section--tight">
    <div class="container pair">
      {%- if hasCompat %}
      <section class="plane" aria-labelledby="compat-title">
        <h2 id="compat-title">Совместимость</h2>
        <ul class="mark-list product__compat" role="list">
          {%- for model in product.data.compatibility %}
          <li>{{ icon("check") }}{{ model }}</li>
          {%- endfor %}
        </ul>
        <p class="note">Перед поставкой сверим совместимость по VIN или серийному номеру машины.</p>
      </section>
      {%- endif %}
      {%- if hasSpecs %}
      <section class="plane" aria-labelledby="specs-title">
        <h2 id="specs-title">Характеристики</h2>
        <table class="price-table product__specs">
          <tbody>
            {%- for spec in product.data.specs %}
            <tr><th scope="row">{{ spec.name }}</th><td>{{ spec.value }}</td></tr>
            {%- endfor %}
          </tbody>
        </table>
      </section>
      {%- endif %}
    </div>
  </div>
  {%- endif %}

  {%- if product.content %}
  <section class="section section--tight" aria-labelledby="opisanie-title">
    <div class="container prose">
      <h2 id="opisanie-title">Описание</h2>
      {{ product.content | safe }}
    </div>
  </section>
  {%- endif %}

  <section class="contact-band" id="vopros" aria-labelledby="vopros-title">
    <div class="container contact-band__inner">
      <div class="contact-band__head">
        <h2 id="vopros-title">Вопрос по детали</h2>
        <a class="contact-band__phone" href="{{ settings.phoneHref }}" data-goal="phone">{{ icon("phone") }}{{ settings.phone }}</a>
      </div>
      {% set leadForm = { type: "callback", id: "product", service: "Каталог запчастей", message: "Вопрос по товару: " + product.data.title + " (арт. " + product.data.sku + ")", variant: "inline", messageLabel: "Вопрос" } %}
      {% include "partials/lead-form.njk" %}
    </div>
  </section>
</article>
