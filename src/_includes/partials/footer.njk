{#- Подвал. Края не перечисляются (R11): только ссылка «Где работаем» на /regiony/. -#}
<footer class="site-footer">
  <div class="container site-footer__top">
    <a class="site-footer__logo" href="/" aria-label="{{ settings.brand }}, на главную">{% image "/assets/brand/logo-horizontal.png", settings.brand, "180px" %}</a>
    <nav class="site-footer__nav" aria-label="Разделы сайта">
      <ul>
        {%- for item in navItems %}{% if item.url | pageExists(collections.all) %}
        <li><a href="{{ item.url }}">{{ item.name }}</a></li>
        {%- endif %}{% endfor %}
        {%- if "/regiony/" | pageExists(collections.all) %}
        <li><a href="/regiony/">Где работаем</a></li>
        {%- endif %}
      </ul>
    </nav>
    <a class="site-footer__phone" href="{{ settings.phoneHref }}" data-goal="phone">{{ settings.phone }}</a>
  </div>
  <div class="container site-footer__bottom">
    <p>© {{ buildDate.getFullYear() }} {{ settings.brand }}. Оператор: {% set value = settings.legal.operator %}{% include "partials/contact-value.njk" %}, ИНН {% set value = settings.legal.inn %}{% include "partials/contact-value.njk" %}, ОГРН {% set value = settings.legal.ogrn %}{% include "partials/contact-value.njk" %}</p>
    <p class="site-footer__legal">
      {%- if "/politika-konfidencialnosti/" | pageExists(collections.all) %}<a href="/politika-konfidencialnosti/">Политика конфиденциальности</a>{% endif %}
      {%- if "/soglasie/" | pageExists(collections.all) %} <a href="/soglasie/">Согласие на обработку персональных данных</a>{% endif %}
    </p>
  </div>
</footer>
