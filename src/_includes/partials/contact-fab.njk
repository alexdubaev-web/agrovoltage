{#- Липкая панель связи на ширине до 768 px (R04): «Позвонить» и «Заявка», как в мобильном макете.
    Ссылка MAX появляется, когда в настройках вписан адрес вместо заглушки. Стили — в main.css
    (body получает отступ снизу, чтобы панель не закрывала контент). -#}
{%- from "partials/icon.njk" import icon -%}
{%- set fabMax = settings.maxUrl and not (settings.maxUrl | isPlaceholder) -%}
<nav class="contact-fab" aria-label="Быстрая связь">
  <a class="btn btn--ghost contact-fab__call" href="{{ settings.phoneHref }}" data-goal="phone" aria-label="Позвонить {{ settings.phone }}">{{ icon("phone") }}Позвонить</a>
  {%- if fabMax %}
  <a class="btn btn--ghost contact-fab__max" href="{{ settings.maxUrl }}" rel="noopener" target="_blank" data-goal="max" aria-label="Написать в MAX">MAX</a>
  {%- endif %}
  <a class="btn btn--primary contact-fab__lead" href="#zayavka" data-lead-open>Заявка</a>
</nav>
