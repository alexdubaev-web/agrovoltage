# Скопируйте в .env и впишите значения. .env не коммитится.

# Сборка сайта (interfaces.md §3)
# Адрес сайта без завершающего слеша, например https://agrovoltage.ru. По умолчанию http://localhost:8080
SITE_URL=
# true открывает индексацию, только вместе с SITE_URL на https://
INDEXABLE=

# Почта (SMTP) для заявок
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=
MAIL_FROM=
MAIL_TO=

# Мессенджер MAX (бот)
MAX_BOT_TOKEN=
MAX_CHAT_ID=
# Адрес Bot API MAX. Пусто — https://platform-api2.max.ru
MAX_API_URL=
