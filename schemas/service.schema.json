{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "service",
  "title": "Услуга",
  "type": "object",
  "required": [
    "title",
    "slug",
    "group",
    "summary"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "латиница в нижнем регистре, цифры и дефисы"
    },
    "group": {
      "type": "string",
      "enum": [
        "diagnostics",
        "electrics",
        "equipment",
        "climate",
        "field"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "priceFrom": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "image": {
      "type": "string",
      "pattern": "^(|/.+|https?://.+)$",
      "description": "путь от корня сайта, например /assets/uploads/foto.jpg"
    },
    "symptoms": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "diagnosticsSteps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "works": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "faq": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "q",
          "a"
        ],
        "properties": {
          "q": {
            "type": "string",
            "minLength": 1
          },
          "a": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "prices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "group",
          "items"
        ],
        "properties": {
          "group": {
            "type": "string",
            "minLength": 1
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "price": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    "order": {
      "type": "number"
    },
    "demo": {
      "type": "boolean"
    },
    "seo": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "ogImage": {
          "type": "string",
          "pattern": "^(|/.+|https?://.+)$",
          "description": "путь от корня сайта, например /assets/uploads/foto.jpg"
        },
        "noindex": {
          "type": "boolean"
        }
      }
    }
  }
}