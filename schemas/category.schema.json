{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "category",
  "title": "Категория каталога",
  "type": "object",
  "required": [
    "title",
    "slug"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "латиница в нижнем регистре, цифры и дефисы"
    },
    "description": {
      "type": "string"
    },
    "image": {
      "type": "string",
      "pattern": "^(|/.+|https?://.+)$",
      "description": "путь от корня сайта, например /assets/uploads/foto.jpg"
    },
    "order": {
      "type": ["number", "null"],
      "description": "пустое значение — в конце списка"
    },
    "seo": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "ogImage": {
          "type": "string",
          "pattern": "^(|/.+|https?://.+)$",
          "description": "путь от корня сайта, например /assets/uploads/foto.jpg"
        },
        "noindex": {
          "type": "boolean"
        }
      }
    }
  }
}