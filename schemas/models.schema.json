{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "models",
  "title": "Модели John Deere",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "series",
      "category",
      "models"
    ],
    "properties": {
      "series": {
        "type": "string",
        "minLength": 1
      },
      "category": {
        "type": "string",
        "minLength": 1
      },
      "models": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}