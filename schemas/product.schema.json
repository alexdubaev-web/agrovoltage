{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "product",
  "title": "Товар",
  "type": "object",
  "required": [
    "title",
    "slug",
    "sku",
    "category",
    "inStock"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "латиница в нижнем регистре, цифры и дефисы"
    },
    "sku": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "латиница в нижнем регистре, цифры и дефисы"
    },
    "price": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "inStock": {
      "type": "boolean"
    },
    "compatibility": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(|/.+|https?://.+)$",
        "description": "путь от корня сайта, например /assets/uploads/foto.jpg"
      }
    },
    "summary": {
      "type": "string"
    },
    "specs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "value"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": [
              "string",
              "number"
            ]
          }
        }
      }
    },
    "demo": {
      "type": "boolean"
    },
    "seo": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "ogImage": {
          "type": "string",
          "pattern": "^(|/.+|https?://.+)$",
          "description": "путь от корня сайта, например /assets/uploads/foto.jpg"
        },
        "noindex": {
          "type": "boolean"
        }
      }
    }
  }
}